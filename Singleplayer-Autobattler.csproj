<Project Sdk="Godot.NET.Sdk/4.6.1">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>SingleplayerAutobattler</RootNamespace>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="GeWuYou.GFramework" Version="0.0.193" />
        <PackageReference Include="GeWuYou.GFramework.Godot" Version="0.0.193" />
        <PackageReference Include="GeWuYou.GFramework.Godot.SourceGenerators" Version="0.0.193" />
        <PackageReference Include="GeWuYou.GFramework.SourceGenerators" Version="0.0.193" />
        <PackageReference Update="Meziantou.Analyzer" Version="3.0.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Update="Meziantou.Polyfill" Version="1.0.101">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
        <PackageReference Include="Mediator.SourceGenerator" Version="3.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="script_templates\**" />
        <Compile Remove="scenes\**" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Remove="script_templates\**" />
        <EmbeddedResource Remove="scenes\**" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="scripts\events\" />
        <Folder Include="scripts\xp_button\" />
    </ItemGroup>
    <ItemGroup>
      <Content Include=".github\dependabot.yml" />
      <Content Include=".github\workflows\auto-tag.yml" />
      <Content Include=".github\workflows\ci.yml" />
      <Content Include=".github\workflows\codeql.yml" />
      <Content Include=".github\workflows\release.yml" />
    </ItemGroup>
</Project>